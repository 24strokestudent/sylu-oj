# SYLU OJ 后端环境变量示例
# 复制为 server/.env 后按本地情况修改；.env 已被 .gitignore 忽略，请勿提交

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sylu_oj
DB_PASSWORD=sylu_oj_dev
DB_NAME=sylu_oj
JWT_SECRET=qwertyui

# ---- 会话 / 令牌 ----
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=在这里填一串随机字符串
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- 服务 ----
PORT=3000
# 前端本地调试地址（parcel / 静态服务器）
CORS_ORIGIN=http://localhost:1234
