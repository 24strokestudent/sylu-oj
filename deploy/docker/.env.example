# SYLU OJ · Docker 部署环境变量
# 用法：cp deploy/docker/.env.example deploy/docker/.env  然后按需修改
# 注意：.env 含数据库口令，已在根 .dockerignore 中排除，切勿提交。

# ---------- 必填：数据库口令 ----------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-root
HYDRO_MONGO_PASSWORD=change-me-hydro

# ---------- 站点 ----------
# 内测用 :80；生产填域名（如 oj.example.edu.cn），Caddy 自动签发 HTTPS
SITE_ADDRESS=:80
SYLU_SITE_NAME=SYLU OJ
# 生产环境必须填完整地址且以 / 结尾，例：https://oj.example.edu.cn/
# 留空则不改动，稍后在控制面板「系统设置」里填写。
SYLU_SITE_URL=
TZ=Asia/Shanghai

# ---------- 镜像与组件版本（默认与 docs/DEPLOY.md 记录一致，升级整组一起动） ----------
SYLU_IMAGE_TAG=local
HYDROOJ_VERSION=5.0.7
HYDRO_UI_VERSION=4.58.5
HYDRO_JUDGE_VERSION=4.0.6
HYDRO_FPS_VERSION=1.6.0
HYDRO_A11Y_VERSION=0.0.4
GO_JUDGE_VERSION=1.12.3
MONGO_TOOLS_VERSION=100.13.0

# ---------- 评测资源 ----------
# 沙箱 /dev/shm 大小（go-judge 内存文件存储 + tmpfs 都在这里）
HYDRO_SHM_SIZE=1g
# 沙箱内 /w、/tmp 的 tmpfs 上限
SYLU_SANDBOX_TMPFS=512m
# 是否加载 sylu-brand 品牌插件（1 开 / 0 关）
SYLU_BRAND_ADDON=1
