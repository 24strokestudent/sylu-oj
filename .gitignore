node_modules
dist
.cache
# IDE / macOS
.idea
*.iml
.DS_Store
*.local

# 环境变量与密钥（保留示例文件）
.env
.env.*
!.env.example

# ---- Hydro 部署与测试产物（来自 PR #2 分支）----
# 依赖与构建产物
build
*.tsbuildinfo
# IDE / macOS / Windows
Thumbs.db
# —— 安全：以下内容一律不得进入版本库（实施计划 §44）——
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
known_hosts
*credentials*
*credential*.json
secrets/
secret/
backup/
backups/
*.dump
deploy/local.env
# 部署/运维本地状态与日志
deploy/.state/
*.log
# 本地参考代码（Hydro 上游只读副本等）
.ref/
# 本地端到端验证产物
.e2e/
# UI 渲染沙箱产物与依赖
test/ui/out/
test/ui/node_modules/
